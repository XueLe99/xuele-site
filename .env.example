# Copy to .env.local for local development. No secrets belong in this repo.

# Public base URL, no trailing slash. Used for canonical/hreflang URLs, sitemap,
# robots.txt, Open Graph and JSON-LD. Falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL (https), then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags (default: false). When false the routes return 404 and the
# sections are left out of the nav, the homepage and the sitemap.
NEXT_PUBLIC_SHOW_BLOG=false
NEXT_PUBLIC_SHOW_PROJECTS=false

# Optional. Formspree form ID; the contact form is rendered only when this is set.
NEXT_PUBLIC_FORMSPREE_ID=
